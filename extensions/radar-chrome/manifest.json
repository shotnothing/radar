{
  "manifest_version": 3,
  "name": "Radar Extension",
  "description": "Captures Chrome page activity and forwards it to the local Radar Chrome collector.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:47321/*",
    "http://localhost:47321/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Radar Extension",
    "default_popup": "popup.html"
  }
}
