RADAR_HOME=${HOME}/.radar
RADAR_HOST=127.0.0.1
RADAR_PORT=5000
RADAR_COORDINATOR_URL=http://${RADAR_HOST}:${RADAR_PORT}
RADAR_COLLECTOR_META=builtin/collector/sample/meta.json
RADAR_SAMPLE_COLLECTOR_DURATION=10
RADAR_SAMPLE_COLLECTOR_HEARTBEAT_INTERVAL=2
RADAR_COLLECTOR_HEARTBEAT_TIMEOUT=5
RADAR_COLLECTOR_CONNECT_TIMEOUT=10
RADAR_COLLECTOR_ORPHAN_GRACE_SECONDS=15
RADAR_SAMPLE_TEXT=Sample collected data from the Radar debug collector.
RADAR_PROCESSOR_CONNECT_TIMEOUT=10
RADAR_CHAT_SKILL_PROCESSOR_DURATION=10
RADAR_CHAT_SKILL_PROCESSOR_HEARTBEAT_INTERVAL=2
RADAR_CHAT_SKILL_FORCE=0
RADAR_COLLECTORS_ROOT=${RADAR_HOME}/collectors
RADAR_SKILL_DIR=${RADAR_HOME}/skill
RADAR_LLM_API_KEY=
RADAR_LLM_BASE_URL=https://api.openai.com/v1
RADAR_LLM_MODEL=gpt-4.1-mini
RADAR_LLM_TIMEOUT_SECONDS=60
RADAR_FILTER_LLM_API_KEY=
RADAR_FILTER_LLM_BASE_URL=https://api.openai.com/v1
RADAR_FILTER_LLM_MODEL=gpt-4.1-mini
RADAR_FILTER_LLM_TIMEOUT_SECONDS=30
RADAR_EXTRACTION_LLM_API_KEY=
RADAR_EXTRACTION_LLM_BASE_URL=https://api.openai.com/v1
RADAR_EXTRACTION_LLM_MODEL=gpt-4.1
RADAR_EXTRACTION_LLM_TIMEOUT_SECONDS=120
RADAR_DEBUG=0
