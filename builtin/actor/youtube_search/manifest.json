{
  "actor_id": "builtin.youtube_search_nab",
  "version": "1.0.0",
  "enabled": true,
  "title": "Search YouTube for kpop",
  "description": "Offers to search kpop on YouTube when the active tab is YouTube.",
  "activation": {
    "mode": "desktop_option",
    "priority": "normal",
    "button_label": "Search kpop"
  },
  "trigger": {
    "polling_interval_seconds": 0.5,
    "filters": {
      "app_patterns": [
        "Google Chrome",
        "com.google.Chrome"
      ],
      "url_patterns": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ]
    },
    "should_trigger": {
      "command": [
        "python3",
        "should_trigger.py"
      ],
      "timeout_seconds": 10
    }
  },
  "action": {
    "command": [
      "python3",
      "action.py"
    ],
    "timeout_seconds": 30
  }
}
